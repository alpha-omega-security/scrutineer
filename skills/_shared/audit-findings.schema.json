{
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "cwe": {
      "type": "string",
      "pattern": "^CWE-[1-9][0-9]*$"
    },
    "reachability": {
      "type": "string",
      "enum": ["reachable"]
    },
    "quality_tier": {
      "type": "string",
      "enum": ["high"]
    },
    "reference": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "tags": {"type": "string"}
      }
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "pattern": "^.+:[1-9][0-9]*$"
    },
    "markdown": {
      "type": "string",
      "minLength": 1,
      "contentMediaType": "text/markdown"
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "severity",
        "confidence",
        "cwe",
        "location",
        "reachability",
        "quality_tier",
        "trace",
        "boundary",
        "validation",
        "discovered_via",
        "rating"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^F[0-9]+$"},
        "sinks": {"type": "array", "items": {"type": "string"}},
        "title": {"type": "string", "minLength": 1},
        "severity": {"$ref": "#/$defs/severity"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "cwe": {"$ref": "#/$defs/cwe"},
        "location": {"$ref": "#/$defs/location"},
        "locations": {
          "type": "array",
          "items": {"$ref": "#/$defs/location"}
        },
        "affected": {"type": "string"},
        "reachability": {"$ref": "#/$defs/reachability"},
        "quality_tier": {"$ref": "#/$defs/quality_tier"},
        "reach_checked": {"type": "integer", "minimum": 0},
        "reach_exposed": {"type": "integer", "minimum": 0},
        "references": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        },
        "trace": {"$ref": "#/$defs/markdown"},
        "boundary": {"$ref": "#/$defs/markdown"},
        "validation": {"$ref": "#/$defs/markdown", "description": "Record the evidence collected under this skill's execution rules. When including PoC files, paste each verbatim in a separate closed Markdown fence with language filename=relative/path on its opening line. Use unique safe relative paths and reserve README.md for bundle instructions. Put build/run commands in a sh filename=run.sh fence and output in separate unnamed text or console fences. Close fences on their own lines; do not use --- FILENAME --- delimiters or claim execution during a static audit."},
        "prior_art": {"$ref": "#/$defs/markdown"},
        "discovered_via": {
          "type": "string",
          "enum": ["source"]
        },
        "reach": {"$ref": "#/$defs/markdown"},
        "rating": {"$ref": "#/$defs/markdown"}
      }
    }
  }
}
