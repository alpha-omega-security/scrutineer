{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "embedded-native report",
  "description": "Brief reports and Git submodule identities for embedded native analysis.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "root": {
      "type": "object",
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "commit": { "type": "string" },
          "purl": { "type": "string" },
          "initialized": { "type": "boolean" },
          "status": { "enum": ["initialized", "unavailable"] },
          "error": { "type": "string" }
        },
        "required": ["path", "url", "commit", "purl", "initialized", "status", "error"]
      }
    },
    "submodules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "error": { "type": "string" }
  },
  "oneOf": [
    { "required": ["schema_version", "root", "components", "submodules"] },
    { "required": ["error"] }
  ]
}
