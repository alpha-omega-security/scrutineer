{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vuln-scan findings report",
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "cwe": {
      "type": "string",
      "pattern": "^(CWE-[0-9]+)?$"
    },
    "reachability": {
      "type": "string",
      "enum": ["reachable", "harness_only", "unclear"]
    },
    "quality_tier": {
      "type": "string",
      "enum": ["high", "low"]
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^:]+:[0-9]+$"
    },
    "markdown": {
      "type": "string",
      "minLength": 1,
      "contentMediaType": "text/markdown"
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "severity",
        "confidence",
        "cwe",
        "location",
        "reachability",
        "quality_tier",
        "trace",
        "boundary",
        "validation",
        "rating"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^F[0-9]+$" },
        "sinks": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "cwe": { "$ref": "#/$defs/cwe" },
        "location": { "$ref": "#/$defs/location" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "affected": { "type": "string" },
        "reachability": { "$ref": "#/$defs/reachability" },
        "quality_tier": { "$ref": "#/$defs/quality_tier" },
        "rule": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Optional stable bug family as a lowercase slug, the same for every finding of this kind in any repository, e.g. sql-injection, path-traversal, missing-authz-check, integer-overflow-alloc."},
        "anchor": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Optional short name for the broken root control, written so it survives file moves and line drift: the guard, check or invariant that is missing or wrong, e.g. archive entry names are joined to the extraction root without rejecting parent segments. No file paths, line numbers or finding ids. Two findings with the same rule and anchor describe the same root cause."},
        "instance": {"type": "string", "minLength": 1, "maxLength": 120, "description": "Optional, only when one root cause is independently attackable at several sites: names this site, e.g. the endpoint or parameter, so it stays apart from the other sites with the same rule and anchor."},
        "reach_checked": { "type": "integer", "minimum": 0 },
        "reach_exposed": { "type": "integer", "minimum": 0 },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "trace": { "$ref": "#/$defs/markdown" },
        "boundary": { "$ref": "#/$defs/markdown" },
        "validation": { "$ref": "#/$defs/markdown" },
        "prior_art": { "$ref": "#/$defs/markdown" },
        "discovered_via": { "type": "string", "enum": ["source", "issue-tracker", "advisory", "documentation"], "description": "How this finding was first identified. Folded into prior_art on ingest." },
        "reach": { "$ref": "#/$defs/markdown" },
        "rating": { "$ref": "#/$defs/markdown" }
      }
    }
  }
}
