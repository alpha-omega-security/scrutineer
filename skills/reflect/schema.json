{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transcript reflection report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notes"
  ],
  "properties": {
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "scan_id",
          "kind",
          "summary",
          "evidence"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "scan_id": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "tool_failure",
              "missing_dependency",
              "reproducer_entrypoint",
              "missing_transcript",
              "no_observation"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
