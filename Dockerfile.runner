# Minimal image for per-job ephemeral containers. Contains only the analysis
# tools, not the web server or database. Built separately (podman build also
# works -- substitute the binary):
#   docker build -t scrutineer-runner -f Dockerfile.runner .

# Keep each release tag beside its architecture-specific digest so Renovate can
# update the selected asset and checksum atomically. A mismatched tag/digest in
# a Renovate PR fails sha256sum below and usually means asset identification
# failed upstream.
ARG CLAUDE_AMD64_LOCK=v2.1.311@sha256:1e506d1d4466d854f0a2ea662f04122c77475e8c71a680bbbdc1c99fefff3fa7
ARG CLAUDE_ARM64_LOCK=v2.1.311@sha256:f464c31d01cd364d1d5df529dc4c202ce9a05c7a87b9fd4fefebb0a8ffe1ecb5

ARG CODEX_AMD64_LOCK=rust-v0.165.0@sha256:e97c4463d7f146692a955d7b0e1c8cf48f97cd4d616cd45c5dcab2e8d9743316
ARG CODEX_ARM64_LOCK=rust-v0.165.0@sha256:c8b2844fdef57498572db960344aee8c836ce9f75c203379da0a9c3a334fc3b7

ARG OPENCODE_AMD64_LOCK=v2.2.0@sha256:6d597970a8cc448f1b9a9f645532584b339dd3ab9583bb5f063f13d83e54768f
ARG OPENCODE_ARM64_LOCK=v2.2.0@sha256:1f1ce0fc07b9245a815ffa9d652dbb80e6b0f07e5bf74ea87d2b1c0339fbac52

ARG COPILOT_AMD64_LOCK=v1.0.104@sha256:fa9722665f2c670aa6ce26f1eb30fbfe7ed0177606bf61c21125855345c9c447
ARG COPILOT_ARM64_LOCK=v1.0.104@sha256:29b3978051df684109e2343b2fccd733f971f8ebe472732fa3e07cfc2093f8e7

ARG SEMGREP_VERSION=1.182.1

ARG BANDIT_VERSION=1.9.4
ARG DARNIT_VERSION=0.1.1

FROM golang:1.27.3-trixie@sha256:1896654cfc5c2b5ad74c07f29cb36f5d2d1cbed42e3054070fbfe444e521e83c AS go-tools

COPY scripts/retry-build-command.sh /usr/local/bin/retry-build-command.sh
# Go proxy/checksum requests can fail transiently.
ARG BETTERLEAKS_VERSION=v1.9.0
RUN GOBIN=/out CGO_ENABLED=0 sh /usr/local/bin/retry-build-command.sh go install -ldflags "-X=github.com/betterleaks/betterleaks/version.Version=${BETTERLEAKS_VERSION}" github.com/betterleaks/betterleaks@${BETTERLEAKS_VERSION}
RUN GOBIN=/out sh /usr/local/bin/retry-build-command.sh go install github.com/git-pkgs/git-pkgs@v0.21.0
RUN GOBIN=/out sh /usr/local/bin/retry-build-command.sh go install github.com/git-pkgs/brief/cmd/brief@v0.14.2

FROM rust:1.98-trixie@sha256:a8a5f0a1e5fe7dfe1d352591e4a1c7dd2c08fd70475cae872cf3458ba0df0546 AS zizmor-build
ENV CARGO_HTTP_MULTIPLEXING=false
RUN cargo install --locked --root /out zizmor@1.31.1

# The runner image carries the proxy commands used by Scrutineer and by
# harness/container consumers. Both are built CGO-free so they can be copied
# into the slim runtime without a glibc dependency.
FROM golang:1.27.3-trixie@sha256:1896654cfc5c2b5ad74c07f29cb36f5d2d1cbed42e3054070fbfe444e521e83c AS scrutineer-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/scrutineer ./cmd/scrutineer && \
    CGO_ENABLED=0 go build -o /out/harness-proxy github.com/alpha-omega-security/harness/cmd/harness-proxy

FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd
ARG CLAUDE_AMD64_LOCK
ARG CLAUDE_ARM64_LOCK
ARG CODEX_AMD64_LOCK
ARG CODEX_ARM64_LOCK
ARG OPENCODE_AMD64_LOCK
ARG OPENCODE_ARM64_LOCK
ARG COPILOT_AMD64_LOCK
ARG COPILOT_ARM64_LOCK
ARG SEMGREP_VERSION
ARG BANDIT_VERSION
ARG DARNIT_VERSION

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git bash coreutils jq \
        python3 python3-venv python3-jsonschema \
        libstdc++6 ripgrep \
 && install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL --connect-timeout 30 --max-time 300 --retry 3 --retry-all-errors https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# semgrep, bandit and darnit in venvs so PEP 668 doesn't require
# --break-system-packages. They get one each rather than sharing: the three are
# pinned and bumped independently, and a shared environment would let a
# semgrep bump drag the others' dependencies with it.
# darnit-mcp is a metapackage whose dependencies carry no version, so the
# packages the audit runs (darnit-core, darnit-baseline) are pinned with it.
# cel-python's c7nlib imports packaging without declaring it.
# Smoke-test required CLIs at build time so missing packages, broken venv
# symlinks or a misplaced framework TOML fail the image build instead of
# later scan jobs.
RUN python3 -m venv /opt/semgrep && \
    /opt/semgrep/bin/pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" "setuptools<81" && \
    ln -s /opt/semgrep/bin/semgrep /usr/local/bin/semgrep && \
    ln -s /opt/semgrep/bin/pysemgrep /usr/local/bin/pysemgrep && \
    python3 -m venv /opt/bandit && \
    /opt/bandit/bin/pip install --no-cache-dir "bandit==${BANDIT_VERSION}" && \
    ln -s /opt/bandit/bin/bandit /usr/local/bin/bandit && \
    python3 -m venv /opt/darnit && \
    /opt/darnit/bin/pip install --no-cache-dir "darnit-mcp==${DARNIT_VERSION}" "darnit-core==${DARNIT_VERSION}" "darnit-baseline==${DARNIT_VERSION}" packaging && \
    ln -s /opt/darnit/bin/darnit /usr/local/bin/darnit && \
    /opt/darnit/bin/python -c 'import sys; from darnit.config import load_framework_config, validate_framework_config; from darnit_baseline.implementation import OSPSBaselineImplementation; errors = validate_framework_config(load_framework_config(OSPSBaselineImplementation().get_framework_config_path())); sys.exit("\n".join(map(str, errors)) if errors else 0)' && \
    python3 --version && \
    jq --version && \
    jsonschema --version && \
    curl --version && \
    gh --version && \
    semgrep --version && \
    pysemgrep --version && \
    bandit --version && \
    darnit --version

ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) arch=x64;   lock="${CLAUDE_AMD64_LOCK}" ;; \
      arm64) arch=arm64; lock="${CLAUDE_ARM64_LOCK}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    tag="${lock%@*}"; \
    sha="${lock#*@sha256:}"; \
    curl -fsSL --connect-timeout 30 --max-time 300 --retry 3 --retry-all-errors -o /tmp/claude.tgz \
      "https://github.com/anthropics/claude-code/releases/download/${tag}/claude-linux-${arch}.tar.gz"; \
    echo "${sha}  /tmp/claude.tgz" | sha256sum -c -; \
    tar -xzf /tmp/claude.tgz -C /usr/local/bin claude && rm /tmp/claude.tgz

# OpenAI codex CLI (-backend codex). Use the release's package archive so the
# CLI and its version-matched code-mode host are installed atomically.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) triple=x86_64-unknown-linux-musl;  lock="${CODEX_AMD64_LOCK}" ;; \
      arm64) triple=aarch64-unknown-linux-musl; lock="${CODEX_ARM64_LOCK}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    tag="${lock%@*}"; \
    sha="${lock#*@sha256:}"; \
    curl -fsSL --connect-timeout 30 --max-time 300 --retry 3 --retry-all-errors -o /tmp/codex.tgz \
      "https://github.com/openai/codex/releases/download/${tag}/codex-package-${triple}.tar.gz"; \
    echo "${sha}  /tmp/codex.tgz" | sha256sum -c -; \
    tar -xzf /tmp/codex.tgz -C /tmp bin/codex bin/codex-code-mode-host; \
    install -m 0755 /tmp/bin/codex /usr/local/bin/codex; \
    install -m 0755 /tmp/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host; \
    rm -rf /tmp/codex.tgz /tmp/bin; \
    codex --version; \
    test -x /usr/local/bin/codex-code-mode-host

# opencode CLI (-backend opencode). The glibc tarball contains a single
# `opencode` binary; it links libstdc++ dynamically (bun runtime), which
# is why libstdc++6 is in the apt install list above.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) ocarch=x64;   lock="${OPENCODE_AMD64_LOCK}" ;; \
      arm64) ocarch=arm64; lock="${OPENCODE_ARM64_LOCK}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    tag="${lock%@*}"; \
    sha="${lock#*@sha256:}"; \
    curl -fsSL --connect-timeout 30 --max-time 300 --retry 3 --retry-all-errors -o /tmp/opencode.tgz \
      "https://github.com/anomalyco/opencode/releases/download/${tag}/opencode-linux-${ocarch}.tar.gz"; \
    echo "${sha}  /tmp/opencode.tgz" | sha256sum -c -; \
    tar -xzf /tmp/opencode.tgz -C /usr/local/bin opencode; \
    rm /tmp/opencode.tgz; \
    opencode --version

# GitHub Copilot CLI (-backend copilot). The glibc tarball contains a single
# `copilot` binary; it links libstdc++ dynamically (same as opencode's bun
# runtime), which is why libstdc++6 is already in the apt install list above.
#
# The binary is a self-extracting bundle: on first run it unpacks a package
# containing a native addon (runtime.node) into a cache dir and dlopen()s it.
# The default cache dir is $XDG_CACHE_HOME/copilot or $HOME/.cache/copilot,
# and the runner sets HOME=/tmp where /tmp is a noexec tmpfs, so that dlopen
# fails with "failed to map segment from shared object". Unpacking here at
# build time into an exec-capable rootfs path and pointing
# COPILOT_PKG_CACHE_HOME (first entry in copilot's package search order) at it
# keeps the runtime lookup off the noexec tmpfs. A read-only rootfs is fine:
# the package is already unpacked, and the harness passes --no-auto-update so
# copilot never tries to write a newer one.
ENV COPILOT_PKG_CACHE_HOME=/usr/local/lib/copilot
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) cparch=x64;   lock="${COPILOT_AMD64_LOCK}" ;; \
      arm64) cparch=arm64; lock="${COPILOT_ARM64_LOCK}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    tag="${lock%@*}"; \
    sha="${lock#*@sha256:}"; \
    curl -fsSL --connect-timeout 30 --max-time 300 --retry 3 --retry-all-errors -o /tmp/copilot.tgz \
      "https://github.com/github/copilot-cli/releases/download/${tag}/copilot-linux-${cparch}.tar.gz"; \
    echo "${sha}  /tmp/copilot.tgz" | sha256sum -c -; \
    tar -xzf /tmp/copilot.tgz -C /usr/local/bin copilot; \
    rm /tmp/copilot.tgz; \
    mkdir -p "${COPILOT_PKG_CACHE_HOME}"; \
    copilot --version; \
    test -d "${COPILOT_PKG_CACHE_HOME}/pkg"; \
    chmod -R a+rX "${COPILOT_PKG_CACHE_HOME}"

COPY --from=go-tools /out/* /usr/local/bin/
COPY --from=zizmor-build /out/bin/zizmor /usr/local/bin/zizmor
COPY --from=scrutineer-build /out/scrutineer /usr/local/bin/scrutineer
COPY --from=scrutineer-build /out/harness-proxy /usr/local/bin/harness-proxy

RUN useradd -ms /bin/bash runner
USER runner
WORKDIR /out
